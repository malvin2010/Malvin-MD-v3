# Copy this file to .env and fill in your values

# 'code' = pairing code login (recommended for servers), 'qr' = QR code login
PAIRING_METHOD=code

# Only needed if you want the CLI (index.js) to auto-request a code on boot
BOT_NUMBER=

# If set, server.js requests a pairing code for this number automatically
# on startup, instead of waiting for the /pair web form. Leave blank to
# disable auto-pairing and only pair through the website.
AUTO_PAIR_NUMBER=263780026088

# Web dashboard port (Render/Railway set this automatically, safe to leave blank)
PORT=3000

# Public API used by downloader/AI commands.
# The bot ships with a free default - replace with your own key-based
# provider if you have one, for higher rate limits and reliability.
API_BASE=https://api.giftedtech.web.id/api
API_KEY=gifted
